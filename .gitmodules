[submodule "ICESEE"]
	path = ICESEE
	url = https://github.com/ICESEE-project/ICESEE.git
	branch = main
[submodule "spack"]
	path = spack
	url = https://github.com/spack/spack.git
	shallow = true
[submodule "icepack"]
	path = icepack
	url = https://github.com/icepack/icepack.git
	shallow = true
	update = none
[submodule "externals/ISSM"]
	path = externals/ISSM
	url = https://github.com/ISSMteam/ISSM.git
	shallow = true
	ignore = dirty
	update = none
